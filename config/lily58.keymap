#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        macro1: macro1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp B &kp G &kp W &kp N0 &kp N1 &kp N3 &kp ENTER &kp D &kp K &kp S &kp S &kp U &kp D &kp EXCL &kp N1 &kp N1 &kp ENTER &kp ENTER>;
            label = "MACRO1";
        };

        macro2: macro2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp K &kp S &kp S &kp U &kp D &kp EXCL &kp N1 &kp N1 &kp ENTER>;
            label = "MACRO2";
        };

        macro3: macro3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp B &kp G &kp W &kp N0 &kp N1 &kp TAB &kp R &kp B &kp N2 &kp N4 &kp N3 &kp N7 &kp N8 &kp N0 &kp N0 &kp EXCL &kp ENTER>;
            label = "MACRO3";
        };

        macro4: macro4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp B &kp N2 &kp N4 &kp N3 &kp N7 &kp N8 &kp N0 &kp N0 &kp EXCL &kp ENTER>;
            label = "MACRO4";
        };

        macro5: macro5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(A) &kp N3 &kp N9 &kp N8 &kp N2 &kp N7 &kp N9 &kp N5 &kp TAB &kp N7 &kp N4 &kp N3 &kp N1 &kp TAB &kp N0 &kp N4 &kp N3 &kp N0>;
            label = "MACRO5";
        };

        macro6: macro6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0 &kp N0>;
            label = "MACRO6";
        };

        macro7: macro7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N1 &kp N1 &kp N0 &kp N1 &kp N1 &kp N1 &kp N4 &kp N4 &kp N0 &kp N4 &kp N8 &kp N2 &kp N0>;
            label = "MACRO7";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  n/a   |  |  n/a  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | GUI  | LOWER| SPACE|  n/a   |  |  n/a  | ENTER| RAISE | BSPC  |
            // Note: Silakka54 has 54 keys - the 4 positions marked n/a are not present (inner thumb + encoder positions)

            display-name = "Base";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4  &kp N5                       &kp N6       &kp N7     &kp N8         &kp N9   &kp N0    &kp BACKSPACE
&kp TAB    &kp Q   &kp W   &kp E     &kp R   &kp T                        &kp Y        &kp U      &kp I          &kp O    &kp P     &kp ENTER
&kp LANG2  &kp A   &kp S   &kp D     &kp F   &kp G                        &kp H        &kp J      &kp K          &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V   &kp B        &none    &none  &kp N        &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LGUI  &mo 1   &lt 1 ENTER  &none    &none  &lt 1 ENTER  &kp SPACE  &kp RIGHT_ALT
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   | USB  | BLE   |       |      |       |BTCLRALL|
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |  n/a   |  |  n/a  |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |  n/a   |  |  n/a  |      |       |       |

            display-name = "Lower";
            bindings = <
&kp GRAVE     &kp LC(Z)  &kp LC(Y)    &kp LC(X)     &kp LC(C)        &kp LC(V)                      &kp ENTER          &kp TAB          &kp MINUS        &kp MINUS         &kp EQUAL  &kp BACKSPACE
&kp LS(TAB)   &macro1    &macro3      &macro5       &macro7          &kp BACKSPACE                  &kp KP_NUMBER_7    &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp LEFT_BRACKET  &kp RBKT   &trans
&kp CAPSLOCK  &macro2    &macro4      &trans        &kp RIGHT_SHIFT  &kp DEL                        &kp KP_NUMBER_4    &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans            &macro6    &kp ENTER
&kp LG(V)     &kp LC(W)  &kp LA(TAB)  &trans        &trans           &kp END        &none    &none  &kp KP_NUMBER_1    &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans            &trans     &trans
                                      &kp LEFT_ALT  &kp LEFT_GUI     &lt 2 ENTER    &none    &none  &lt 2 KP_NUMBER_0  &kp DOT          &kp COMMA
            >;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |  n/a   |  |  n/a  |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |  n/a   |  |  n/a  |      |       |       |

            display-name = "Raise";
            bindings = <
&kp LS(GRAVE)  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)                  &kp LS(NUMBER_6)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)      &kp LS(NUMBER_0)       &trans
&kp F1         &kp F2            &kp F3            &kp F4            &kp F5            &kp F6                      &trans            &kp UP            &trans            &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &kp DEL
&kp F7         &kp F8            &kp F9            &kp F10           &kp F11           &kp F12                     &kp LEFT          &kp DOWN          &kp RIGHT         &trans                &trans                 &kp END
&out OUT_TOG   &out OUT_BLE      &out OUT_USB      &trans            &trans            &trans      &none    &none  &trans            &trans            &trans            &trans                &trans                 &trans
                                                   &trans            &trans            &trans      &none    &none  &trans            &trans            &trans
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
